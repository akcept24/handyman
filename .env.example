# Copy to .env only for local use. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENROUTER_API_KEY=
# Long random server-side secret shared only with the configured voice tool.
VOICE_TOOL_SECRET=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
CHAT_DAILY_LIMIT=200
# Set only when the app is reachable exclusively through that many trusted proxies.
TRUST_PROXY_HOPS=0
PORT=3000

# Owner fallback for web leads: alert email + durable local lead store.
# OWNER_ALERT_EMAIL receives the full lead when Telegram does not confirm.
OWNER_ALERT_EMAIL=
RESEND_API_KEY=<redacted>